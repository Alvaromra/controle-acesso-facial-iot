# Copie para .env e preencha. O .env esta no .gitignore.

# ESP32-CAM (IP fixo definido em firmware/esp32-cam/secrets.h)
IP_CAMERA=192.168.0.50

# Tuya Cloud (credenciais do projeto em iot.tuya.com)
TUYA_ACCESS_ID=
TUYA_ACCESS_KEY=
TUYA_API_ENDPOINT=https://openapi.tuyaus.com
TUYA_DEVICE_ID=

# Broker MQTT (Mosquitto rodando no mesmo PC do painel)
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883

# Painel web
PAINEL_HOST=0.0.0.0
PAINEL_PORTA=5000
PAINEL_USUARIO=admin
# Defina uma senha forte. Vazio = painel sem login.
PAINEL_SENHA=
